{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Дизайн-токены сайта odrodok.ru. Формат W3C Design Tokens — читается Figma Tokens, Style Dictionary и подобными инструментами.",

  "color": {
    "$type": "color",
    "palette": {
      "$description": "Сырые цвета. В макетах и вёрстке использовать семантику ниже, не эти значения.",
      "paper":  { "$value": "#F2ECE0", "$description": "бумага — фон страницы" },
      "paper2": { "$value": "#E9E2D3", "$description": "бумага темнее — второстепенные поверхности" },
      "card":   { "$value": "#FDFCFA", "$description": "белая бумага блоков, как поля обложек" },
      "ink":    { "$value": "#171512", "$description": "текст, рамки, тени" },
      "soft":   { "$value": "#70695C", "$description": "приглушённый текст, подписи" },
      "brick":  { "$value": "#D84220", "$description": "акцент — знак, кнопка воспроизведения" },
      "mark":   { "$value": "#F7D86E", "$description": "жёлтая подсветка при наведении" }
    },
    "semantic": {
      "background":     { "$value": "{color.palette.paper}" },
      "surface":        { "$value": "{color.palette.card}" },
      "surface-muted":  { "$value": "{color.palette.paper2}" },
      "text":           { "$value": "{color.palette.ink}" },
      "text-muted":     { "$value": "{color.palette.soft}" },
      "accent":         { "$value": "{color.palette.brick}" },
      "highlight":      { "$value": "{color.palette.mark}" },
      "line":           { "$value": "#17151233", "$description": "тонкая линия — ink 20%" }
    }
  },

  "space": {
    "$type": "dimension",
    "$description": "Крупные интервалы считаются от плотности 1.5, мелкие фиксированы.",
    "gap-s": { "$value": "0.5rem" },
    "gap-m": { "$value": "1rem" },
    "gap-l": { "$value": "1.5rem" },
    "sp-s":  { "$value": "1.2rem", "$description": "density × 0.8rem" },
    "sp-m":  { "$value": "2.4rem", "$description": "density × 1.6rem" },
    "sp-l":  { "$value": "3.6rem", "$description": "density × 2.4rem" }
  },

  "border": {
    "width": {
      "$type": "dimension",
      "s": { "$value": "1px", "$description": "рамка блока" },
      "m": { "$value": "2px", "$description": "акцентная линия" }
    },
    "radius": {
      "$type": "dimension",
      "default": { "$value": "0", "$description": "скруглений в системе нет" }
    }
  },

  "shadow": {
    "$type": "shadow",
    "$description": "Только жёсткие тени без размытия: блок физически лежит на бумаге. При наведении отходит, при нажатии прилипает.",
    "rest": {
      "$value": { "offsetX": "3px", "offsetY": "3px", "blur": "0", "spread": "0", "color": "{color.palette.ink}" }
    },
    "rest-small": {
      "$value": { "offsetX": "2px", "offsetY": "2px", "blur": "0", "spread": "0", "color": "{color.palette.ink}" }
    },
    "lift": {
      "$value": { "offsetX": "7px", "offsetY": "7px", "blur": "0", "spread": "0", "color": "{color.palette.ink}" },
      "$description": "наведение — блок приподнят, сам сдвигается на -2px"
    },
    "lift-small": {
      "$value": { "offsetX": "5px", "offsetY": "5px", "blur": "0", "spread": "0", "color": "{color.palette.ink}" }
    },
    "pressed": {
      "$value": { "offsetX": "0", "offsetY": "0", "blur": "0", "spread": "0", "color": "{color.palette.ink}" },
      "$description": "нажатие — тень схлопывается, блок уезжает на +3px"
    }
  },

  "font": {
    "family": {
      "$type": "fontFamily",
      "display": { "$value": ["OCRABecker", "monospace"], "$description": "заголовки, подписи, интерфейс — айдентика" },
      "text":    { "$value": ["Elem", "ui-sans-serif", "system-ui", "Arial", "sans-serif"], "$description": "Basis Grotesque — запасной для длинных текстов" }
    },
    "size": {
      "$type": "dimension",
      "title":   { "$value": "min(3.2em, 7.6vw)", "$description": "ограничен шириной экрана — длинное название не вылезает" },
      "body":    { "$value": "1.1em" },
      "label":   { "$value": "0.8em" },
      "caption": { "$value": "0.78em" }
    },
    "lineHeight": {
      "text": { "$value": 1.6 },
      "title": { "$value": 1.02 }
    },
    "letterSpacing": {
      "$type": "dimension",
      "label": { "$value": "0.16em" },
      "text":  { "$value": "0.04em" }
    },
    "stroke": {
      "$type": "dimension",
      "$description": "Контур набора. Рисуется под заливкой (paint-order: stroke fill), поэтому буква толстеет наружу.",
      "text":  { "$value": "1px" },
      "title": { "$value": "2px" }
    }
  },

  "layout": {
    "$type": "dimension",
    "page-width":  { "$value": "68rem", "$description": "максимальная ширина полосы" },
    "label-column":{ "$value": "9rem",  "$description": "колонка подписей слева" },
    "breakpoint-mobile": { "$value": "768px" }
  },

  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "100ms" },
      "base": { "$value": "180ms" }
    },
    "easing": {
      "$type": "cubicBezier",
      "default": { "$value": [0.2, 0.7, 0.3, 1] }
    }
  },

  "texture": {
    "$description": "Зерно бумаги — два слоя SVG-шума поверх страницы, fixed. Крутится через прозрачность.",
    "grain-coarse": { "$value": { "baseFrequency": 0.22, "octaves": 5, "opacity": 0.075 } },
    "grain-fine":   { "$value": { "baseFrequency": 0.9,  "octaves": 4, "opacity": 0.11 } }
  }
}
